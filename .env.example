# Loja Zedy — checkout externo (somente servidor)
# https://app.zedy.com.br/docs#lovable
# Token em /admin/{storeId}/settings/api-tokens; o Store ID é o número na URL do admin.
ZEDY_API_TOKEN=
ZEDY_STORE_ID=

# PixGate — PIX (somente servidor). Integrações → API Key em app.pixgateip.com
PIXGATE_API_KEY=
